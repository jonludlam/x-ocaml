; A universe for the browser tests of the js_top_worker backend: a
; js_top_worker toplevel with the widget library, the cmis and compiled
; libraries of the packages below, and a findlib_index.json naming the
; worker. Built only when the browser tests ask for it.

(alias
 (name default))

(executable
 (name worker)
 (modes js)
 (link_flags (-linkall))
 (js_of_ocaml
  (javascript_files ../../js_top_worker/lib/stubs.js)
  (flags --effects=disabled --toplevel --opt 3 +toplevel.js +dynlink.js))
 (libraries js_top_worker-web logs.browser js_top_worker-widget))

; jtw finds packages with findlib, so the workspace's own (the widget
; library) are installed into _build/install first; it asks opam which
; switch to take them from, so it is told the one this build uses.

(rule
 (targets
  (dir universe))
 (deps
  worker.bc.js
  %{bin:jtw}
  (package js_top_worker-widget))
 (action
  (system
   "set -e; prefix=\"${OPAM_SWITCH_PREFIX:?run dune under opam}\"; \
    case \"$prefix\" in */_opam) switch=\"${prefix%/_opam}\" ;; *) switch=\"${prefix##*/}\" ;; esac; \
    OCAMLPATH=\"$(cd ../../../install/default/lib && pwd):${OCAMLPATH:-$prefix/lib}\" \
    %{bin:jtw} opam --no-worker --switch \"$switch\" -o universe js_top_worker-widget >/dev/null; \
    cp worker.bc.js universe/worker.js; \
    printf 'import json,sys\\nf=sys.argv[1]\\nd=json.load(open(f))\\nd[\"compiler\"]={\"worker_url\":\"worker.js\"}\\njson.dump(d,open(f,\"w\"))\\n' | python3 - universe/findlib_index.json")))
