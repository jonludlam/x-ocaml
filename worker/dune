; eval.ml is eval.cppo.ml with -D OXCAML on OxCaml, where the toplevel's
; value accessors live in Toploop rather than Topeval.

(rule
 (targets eval.ml)
 (deps
  (:x eval.cppo.ml))
 (enabled_if
  (not %{ocaml-config:ox}))
 (action
  (run %{bin:cppo} -V OCAML:%{ocaml_version} %{x} -o %{targets})))

(rule
 (targets eval.ml)
 (deps
  (:x eval.cppo.ml))
 (enabled_if %{ocaml-config:ox})
 (action
  (run %{bin:cppo} -V OCAML:%{ocaml_version} -D OXCAML %{x} -o %{targets})))

(library
 (name x_worker)
 ; OxCaml's toplevel libraries ship without cmx files.
 (ocamlopt_flags
  (:standard -w -58))
 (libraries
  brr
  js_of_ocaml
  js_of_ocaml-toplevel
  x-ocaml.protocol
  x-ocaml.lib
  x-ocaml.lib.cells
  x-ocaml.focs-check
  merlin-js.worker
  (select
   ocamlfmt.ml
   from
   (ocamlformat-lib
    ocamlformat-lib.parser_extended
    ocamlformat-lib.format_
    ->
    ocamlfmt.real.ml)
   (-> ocamlfmt.stub.ml))))

(rule
 (targets export.txt)
 (deps export-stdlib.txt)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (cat %{deps})
    (echo "Ast_mapper\n")
    (echo "X_ocaml_lib\n")
    (echo "Focs_check\n")))))

(rule
 (target export-stdlib.txt)
 (action
  (run
   jsoo_listunits
   -o
   %{target}
   stdlib
   %{dep:../worker-lib/x_ocaml_lib.cma})))
