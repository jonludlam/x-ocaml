; x-ocaml's worker with widgets: Widget and the Ui toolkit linked in, and
; visible to cells.
(executable
 (name x_worker)
 (libraries x_worker x-ocaml-widgets x-ocaml-ui)
 (link_flags (-linkall))
 (modes js)
 (js_of_ocaml
  (javascript_files ../../worker/stubs.js)
  (sourcemap no)
  (flags --export=%{dep:export.txt} --toplevel)))

(rule
 (targets export.txt)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (cat %{dep:../../worker/export.txt})
    (echo
     "Widget\nUi\n")))))
