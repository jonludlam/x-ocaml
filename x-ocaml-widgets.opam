opam-version: "2.0"
synopsis:
  "js_top_worker's Widget library in x-ocaml cells, drawn as displays"
maintainer: ["art.wendling@gmail.com"]
authors: ["Arthur Wendling"]
license: "MIT"
homepage: "https://github.com/art-w/x-ocaml"
bug-reports: "https://github.com/art-w/x-ocaml/issues"
depends: [
  "dune" {>= "3.17"}
  "x-ocaml"
  "js_top_worker-widget"
  "brr" {>= "0.0.7"}
  "js_of_ocaml" {>= "6.0.1"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/art-w/x-ocaml.git"
